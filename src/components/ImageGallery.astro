---
import { Image } from "astro:assets";
const { images } = Astro.props;
---

<div class="gallery">
  {images.map((img) => (
    <Image src={img.src} alt={img.alt} />
  ))}
</div>

<style>
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
}
.gallery :global(img) {
  width: 100%;
  height: 250px;
  object-fit: cover;
}
</style>